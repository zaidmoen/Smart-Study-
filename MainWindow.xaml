<Window x:Class="SmartStudy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SmartStudy.Views"
        mc:Ignorable="d"
        Title="Smart Study"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                    <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource PrimaryGradientBrush}">
                            <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Smart Study" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <TextBlock Text="{Binding PageTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="•" Margin="10,0" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding CurrentDateText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="46" Height="52" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" />
                    <Button Width="46" Height="52" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MaximizeButton_Click" />
                    <Button Width="46" Height="52" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#FEE2E2" />
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main shell -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}" Padding="16,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="#18FFFFFF" CornerRadius="16" Padding="16" Margin="0,0,0,20">
                        <StackPanel FlowDirection="RightToLeft">
                            <TextBlock Text="{Binding GreetingText}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right" />
                            <TextBlock Text="{Binding CurrentTimeText}" Foreground="#B9C0CE" FontSize="12" Margin="0,8,0,0" TextAlignment="Right" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Tag="{Binding IsDashboardPage}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="لوحة اليوم" FontSize="14" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Tasks" Tag="{Binding IsTasksPage}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="المهام" FontSize="14" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Focus" Tag="{Binding IsFocusPage}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="غرفة التركيز" FontSize="14" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Analytics" Tag="{Binding IsAnalyticsPage}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="التحليلات" FontSize="14" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <Border Background="#12FFFFFF" CornerRadius="14" Padding="14" Margin="0,0,0,12" FlowDirection="RightToLeft">
                            <StackPanel>
                                <TextBlock Text="هدف اليوم" Foreground="#D0D5DD" FontSize="12" TextAlignment="Right" />
                                <TextBlock Text="{Binding DailyGoalText}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,9" TextAlignment="Right" />
                                <ProgressBar Value="{Binding DailyGoalProgress}" Maximum="100" Style="{StaticResource ThinProgressBarStyle}" Foreground="{StaticResource AccentBrush}" Background="#33FFFFFF" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="تصدير" Command="{Binding ExportDataCommand}" Style="{StaticResource NavButtonStyle}" FontSize="12" Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="استيراد" Command="{Binding ImportDataCommand}" Style="{StaticResource NavButtonStyle}" FontSize="12" Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="26,22,26,18">
                <views:DashboardView Visibility="{Binding IsDashboardPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:TasksView Visibility="{Binding IsTasksPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:FocusView Visibility="{Binding IsFocusPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:AnalyticsView Visibility="{Binding IsAnalyticsPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FlowDirection="RightToLeft" TextAlignment="Right" />
                <TextBlock Grid.Column="1" Text="Smart Study v2.0 • Local-first" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
