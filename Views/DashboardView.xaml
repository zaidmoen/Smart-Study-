<UserControl x:Class="SmartStudy.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource BodyTextStyle}" Margin="0,7,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="12" Padding="14,9" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimeText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                </Border>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,7,0">
                    <StackPanel>
                        <Border Width="38" Height="38" Background="#EEF2FF" CornerRadius="11" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding PendingTasksCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,3" TextAlignment="Right" />
                        <TextBlock Text="مهام معلقة" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <Border Width="38" Height="38" Background="#ECFDF3" CornerRadius="11" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding CompletedToday}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,3" TextAlignment="Right" />
                        <TextBlock Text="مكتملة اليوم" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <Border Width="38" Height="38" Background="#FFF7ED" CornerRadius="11" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding TodayFocusText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,3" TextAlignment="Right" />
                        <TextBlock Text="تركيز اليوم" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="7,0,0,0">
                    <StackPanel>
                        <Border Width="38" Height="38" Background="#FDF2FA" CornerRadius="11" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="#DB2777" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding StudyStreakText}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,3" TextAlignment="Right" />
                        <TextBlock Text="سلسلة الدراسة" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{StaticResource SidebarGradientBrush}" CornerRadius="22" Padding="22" Margin="0,0,0,20" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="الاختيار الذكي للجلسة القادمة" Foreground="#C7D2FE" FontSize="12" TextAlignment="Right" />
                        <TextBlock Text="{Binding RecommendedTaskTitle}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,8,0,5" TextWrapping="Wrap" TextAlignment="Right" />
                        <TextBlock Text="{Binding RecommendedTaskMeta}" Foreground="#D0D5DD" FontSize="12" TextAlignment="Right" />
                        <TextBlock Text="{Binding RecommendationReason}" Foreground="#E4E7EC" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Right" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="ابدأ التركيز"
                            Command="{Binding FocusTaskCommand}"
                            CommandParameter="{Binding RecommendedTask}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding HasRecommendation}" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="الأولوية الآن" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="أقرب خمس مهام تحتاج انتباهك" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="عرض كل المهام" Command="{Binding NavigateCommand}" CommandParameter="Tasks" Style="{StaticResource TextButtonStyle}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DashboardTasks}" ItemTemplate="{StaticResource TaskCardTemplate}" />

                        <Border Visibility="{Binding HasPendingTasks, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="30">
                            <StackPanel>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="رائع، لا توجد مهام معلقة" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,4" TextAlignment="Center" />
                                <TextBlock Text="أضف هدفًا جديدًا عندما تكون جاهزًا." Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="تقدم اليوم" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding DailyGoalText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,18,0,8" TextAlignment="Right" />
                            <ProgressBar Value="{Binding DailyGoalProgress}" Maximum="100" Style="{StaticResource ThinProgressBarStyle}" Height="10" />
                            <TextBlock Text="هدف يومي يساعدك تبني عادة ثابتة بدل دفعات مؤقتة." Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="ملخص الأداء" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="نسبة الإنجاز" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding CompletionRateText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="الأكثر دراسة" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding TopSubjectText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                            <Button Content="افتح التحليلات" Command="{Binding NavigateCommand}" CommandParameter="Analytics" Style="{StaticResource SecondaryButtonStyle}" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
