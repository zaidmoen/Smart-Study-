<UserControl x:Class="SmartStudy.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource BodyTextStyle}" Margin="0,7,0,0" />
            </StackPanel>

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي الإنجاز" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding CompletionRateText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,13,0,6" TextAlignment="Right" />
                        <TextBlock Text="{Binding CompletedTasks, StringFormat={}{0} مهمة مكتملة}" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="تركيز الأسبوع" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding WeekFocusText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,13,0,6" TextAlignment="Right" />
                        <TextBlock Text="آخر سبعة أيام" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="المهام المتأخرة" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding OverdueTasksCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,13,0,6" TextAlignment="Right" />
                        <TextBlock Text="تحتاج معالجة" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="سلسلة النشاط" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding StudyStreakText}" FontSize="27" FontWeight="Bold" Foreground="#DB2777" Margin="0,13,0,6" TextAlignment="Right" />
                        <TextBlock Text="استمر بدون انقطاع" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="دقائق التركيز خلال 7 أيام" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="الهدف ليس يومًا مثاليًا، بل اتجاه يتحسن أسبوعًا بعد أسبوع." Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />

                        <Border Height="210" Margin="0,24,0,0" Background="#F8FAFC" CornerRadius="16" Padding="20">
                            <ItemsControl ItemsSource="{Binding WeeklyStats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7,0">
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Border Grid.Row="0"
                                                    Width="28"
                                                    Height="{Binding BarHeight}"
                                                    Background="{StaticResource PrimaryGradientBrush}"
                                                    CornerRadius="8,8,3,3"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Text="{Binding MinutesLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,7,0,2" />
                                            <TextBlock Grid.Row="2" Text="{Binding DayLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="توزيع المواد" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="بناءً على جلسات التركيز والمهام المكتملة." Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />

                        <ItemsControl ItemsSource="{Binding SubjectStats}" Margin="0,20,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding AccentHex, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding MinutesLabel}" Style="{StaticResource CaptionTextStyle}" />
                                        </Grid>
                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Style="{StaticResource ThinProgressBarStyle}" Foreground="{Binding AccentHex, Converter={StaticResource HexToBrushConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Visibility="{Binding HasSessions, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Background="#F8FAFC" CornerRadius="14" Padding="24" Margin="0,20,0,0">
                            <TextBlock Text="أكمل أول جلسة تركيز حتى تظهر تحليلات المواد." Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="ملاحظة ذكية" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="إذا تراكمت المهام المتأخرة، ابدأ بأقصر مهمة عالية الأولوية لاستعادة الزخم بسرعة." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0">
                        <TextBlock Text="أفضل مادة حاليًا" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding TopSubjectText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0" TextAlignment="Right" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="18,0,0,0">
                        <TextBlock Text="الخطوة القادمة" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding RecommendedTaskTitle}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
